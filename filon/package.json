{
  "name": "filon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ocelle — une base persistante : rubans, vent, montagnes à creuser et un marché mondial, dans un désert à la Moebius.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p src/sim && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude 'src/sim/bench/**' && vitest run src/sim/bench",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sim",
    "bench": "vitest run src/sim/bench",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/patrick-hand-sc": "^5.3.0",
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.60.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
